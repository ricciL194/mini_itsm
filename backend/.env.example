# 应用配置
APP_NAME=Mini ITSM
APP_VERSION=1.0.0
DEBUG=true

# 数据库
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/mini_itsm

# JWT 配置（生产环境请使用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码配置
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
